    ; asmsyntax=nasm
section .note.GNU-stack noalloc noexec nowrite progbits
section .text
extern print_i64
extern println_i64
global asm_main

asm_main:
    ; setup
    ; save registers
    push rbx
    push rbp
    push r12
    push r13
    push r14
    push r15
    ; reserve space for register spills
    sub rsp, 2048
    ; initialize heap pointer
    mov rbx, rdi
    ; initialize free pointer
    mov rbp, rbx
    add rbp, 64
    ; move parameters into place
    mov rdi, rdx
    ; move parameters into place
    mov rdx, rsi
    ; actual code

main_:
    ; create a_14: _Cont = ()\{ ... \};
    ; #mark no allocation
    mov r8, 0
    ; #load tag
    lea r9, [rel _Cont_1]
    ; main_loop(...)
    jmp main_loop_

_Cont_1:

_Cont_1_Ret:
    ; exit x0_3
    mov rax, rdx
    jmp cleanup

tfib_:
    ; if n_4 == 0 \{ ... \}
    cmp rdx, 0
    je lab2
    ; else branch
    ; lit x_15 <- 1;
    mov r13, 1
    ; x_16 <- n_4 - x_15;
    mov r15, rdx
    sub r15, r13
    ; substitute (x_16 := x_16)(a_5 := a_5)(b_6 := b_6)(a0_7 := a0_7);
    ; #move variables
    mov rdx, r15
    ; x_17 <- a_5 + b_6;
    mov r13, rdi
    add r13, r9
    ; substitute (x_16 := x_16)(x_17 := x_17)(a_5 := a_5)(a0_7 := a0_7);
    ; #move variables
    mov r9, rdi
    mov rdi, r13
    ; tfib(...)
    jmp tfib_

lab2:
    ; then branch
    ; substitute (a_5 := a_5)(a0_7 := a0_7);
    ; #move variables
    mov rdx, rdi
    mov rsi, r10
    mov rdi, r11
    ; invoke a0_7 Ret
    ; #there is only one clause, so we can jump there directly
    jmp rdi

fib_:
    ; lit x_18 <- 0;
    mov r9, 0
    ; lit x_19 <- 1;
    mov r11, 1
    ; substitute (n_8 := n_8)(x_18 := x_18)(x_19 := x_19)(a0_9 := a0_9);
    ; #move variables
    mov r10, rsi
    mov rcx, r9
    mov r9, r11
    mov r11, rdi
    mov rdi, rcx
    ; tfib(...)
    jmp tfib_

main_loop_:
    ; substitute (n_25 := n_11)(n_11 := n_11)(a0_12 := a0_12)(iters_10 := iters_10);
    ; #move variables
    mov r11, rdx
    mov rdx, rdi
    ; create a_20: _Cont = (n_11, a0_12, iters_10)\{ ... \};
    ; #allocate memory
    ; ##store values
    mov [rbx + 56], r11
    mov qword [rbx + 48], 0
    mov [rbx + 40], r9
    mov [rbx + 32], r8
    mov [rbx + 24], rdi
    mov qword [rbx + 16], 0
    ; ##acquire free block from heap register
    mov rsi, rbx
    ; ##get next free block into heap register
    ; ###(1) check linear free list for next block
    mov rbx, [rbx + 0]
    cmp rbx, 0
    je lab14
    ; ####initialize refcount of just acquired block
    mov qword [rsi + 0], 0
    jmp lab15

lab14:
    ; ###(2) check non-linear lazy free list for next block
    mov rbx, rbp
    mov rbp, [rbp + 0]
    cmp rbp, 0
    je lab12
    ; ####mark linear free list empty
    mov qword [rbx + 0], 0
    ; ####erase children of next block
    ; #####check child 1 for erasure
    mov rcx, [rbx + 16]
    cmp rcx, 0
    je lab5
    ; ######check refcount
    cmp qword [rcx + 0], 0
    je lab3
    ; ######either decrement refcount ...
    add qword [rcx + 0], -1
    jmp lab4

lab3:
    ; ######... or add block to lazy free list
    mov [rcx + 0], rbp
    mov rbp, rcx

lab4:

lab5:
    ; #####check child 2 for erasure
    mov rcx, [rbx + 32]
    cmp rcx, 0
    je lab8
    ; ######check refcount
    cmp qword [rcx + 0], 0
    je lab6
    ; ######either decrement refcount ...
    add qword [rcx + 0], -1
    jmp lab7

lab6:
    ; ######... or add block to lazy free list
    mov [rcx + 0], rbp
    mov rbp, rcx

lab7:

lab8:
    ; #####check child 3 for erasure
    mov rcx, [rbx + 48]
    cmp rcx, 0
    je lab11
    ; ######check refcount
    cmp qword [rcx + 0], 0
    je lab9
    ; ######either decrement refcount ...
    add qword [rcx + 0], -1
    jmp lab10

lab9:
    ; ######... or add block to lazy free list
    mov [rcx + 0], rbp
    mov rbp, rcx

lab10:

lab11:
    jmp lab13

lab12:
    ; ###(3) fall back to bump allocation
    mov rbp, rbx
    add rbp, 64

lab13:

lab15:
    ; #load tag
    lea rdi, [rel _Cont_16]
    ; fib(...)
    jmp fib_

_Cont_16:

_Cont_16_Ret:
    ; #load from memory
    ; ##check refcount
    cmp qword [rsi + 0], 0
    je lab18
    ; ##either decrement refcount and share children...
    add qword [rsi + 0], -1
    ; ###load values
    mov r11, [rsi + 56]
    mov r9, [rsi + 40]
    mov r8, [rsi + 32]
    cmp r8, 0
    je lab17
    ; ####increment refcount
    add qword [r8 + 0], 1

lab17:
    mov rdi, [rsi + 24]
    jmp lab19

lab18:
    ; ##... or release blocks onto linear free list when loading
    ; ###release block
    mov [rsi + 0], rbx
    mov rbx, rsi
    ; ###load values
    mov r11, [rsi + 56]
    mov r9, [rsi + 40]
    mov r8, [rsi + 32]
    mov rdi, [rsi + 24]

lab19:
    ; lit x_21 <- 1;
    mov r13, 1
    ; if iters_10 == x_21 \{ ... \}
    cmp r11, r13
    je lab20
    ; else branch
    ; substitute (iters_10 := iters_10)(n_11 := n_11)(a0_12 := a0_12);
    ; #move variables
    mov rdx, r11
    ; lit x_22 <- 1;
    mov r11, 1
    ; x_23 <- iters_10 - x_22;
    mov r13, rdx
    sub r13, r11
    ; substitute (x_23 := x_23)(n_11 := n_11)(a0_12 := a0_12);
    ; #move variables
    mov rdx, r13
    ; main_loop(...)
    jmp main_loop_

lab20:
    ; then branch
    ; substitute (res_13 := res_13)(a0_12 := a0_12);
    ; #move variables
    mov rsi, r8
    mov rdi, r9
    ; println_i64 res_13;
    ; #save caller-save registers
    mov r12, rdx
    mov r13, rsi
    mov r14, rdi
    sub rsp, 8
    ; #move argument into place
    mov rdi, rdx
    call println_i64
    ; #restore caller-save registers
    mov rdx, r12
    mov rsi, r13
    mov rdi, r14
    add rsp, 8
    ; substitute (a0_12 := a0_12);
    ; #move variables
    mov rax, rsi
    mov rdx, rdi
    ; lit x_24 <- 0;
    mov rdi, 0
    ; substitute (x_24 := x_24)(a0_12 := a0_12);
    ; #move variables
    mov rsi, rax
    mov rcx, rdi
    mov rdi, rdx
    mov rdx, rcx
    ; invoke a0_12 Ret
    ; #there is only one clause, so we can jump there directly
    jmp rdi

cleanup:
    ; free space for register spills
    add rsp, 2048
    ; restore registers
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbp
    pop rbx
    ret